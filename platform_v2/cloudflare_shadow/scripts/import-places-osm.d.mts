export type OsmPoint = { lat: number; lon: number };
export type OsmElement = {
  type: "node" | "way" | "relation";
  id: number;
  lat?: number;
  lon?: number;
  tags?: Record<string, string>;
  geometry?: OsmPoint[];
  bounds?: { minlat: number; minlon: number; maxlat: number; maxlon: number };
  members?: Array<{ type: string; ref: number; role: string; geometry?: OsmPoint[] }>;
};
export type Ring = number[][];
export type Polygons = Ring[][];
export type OsmAlias = { alias: string; normalized: string; language: string | null; kind: string };
export type OsmCandidate = {
  osmType: "node" | "way" | "relation";
  osmId: number;
  sourceType: "osm" | "osm_node";
  sourceId: string;
  sourceUrl: string;
  name: string;
  aliases: OsmAlias[];
  description: string | null;
  category: "park" | "nature" | "heritage";
  heritage: boolean;
  placeKind: string;
  isCircle: boolean;
  polygons: Polygons;
  toleranceM: number;
  points: number;
  bbox: { west: number; south: number; east: number; north: number };
  lat: number;
  lng: number;
  areaHa: number;
  tags: Record<string, string>;
};
export type OsmPlace = OsmCandidate & { placeId: string };
export type ExistingPlaces = { sourceIds?: string[]; places?: Array<{ name: string; lat: number; lng: number }> };
export type BuildOptions = { existing?: ExistingPlaces; toleranceM?: number; maxPoints?: number; pointRadiusM?: number; circlePoints?: number; parkMinHa?: number; dedupeMeters?: number };
export type BuildResult = { places: OsmPlace[]; rejected: Record<string, number>; dropped: Record<string, number>; evaluated: number; candidates: number };
export type ImportContext = { batch: string; locality: string | null; retrievedAt: string };
export const DEFAULTS: { toleranceM: number; maxPoints: number; pointRadiusM: number; circlePoints: number; parkMinHa: number; dedupeMeters: number };
export const AREAS: Record<string, { slug: string; name: string; adminLevel: string; locality: string }>;
export function normalizePlaceSearchText(value: unknown): string;
export function haversineMeters(aLat: number, aLng: number, bLat: number, bLng: number): number;
export function buildOverpassQuery(scope: { kind: "bbox"; bbox: number[] } | { kind: "relation"; relationId: string } | { kind: "area"; name: string; adminLevel: string }): string;
export function pickNames(tags: Record<string, string>): { name: string; aliases: OsmAlias[] };
export function classifyFeature(tags: Record<string, string>): { category: "park" | "nature" | "heritage"; heritage: boolean; placeKind: string } | null;
export function stitchRings(segments: number[][][]): number[][][];
export function elementPolygons(el: OsmElement): Polygons;
export function polygonsAreaHa(polygons: Polygons): number;
export function douglasPeucker(ring: Ring, toleranceM: number): Ring;
export function simplifyPolygons(polygons: Polygons, options?: { toleranceM?: number; maxPoints?: number }): { polygons: Polygons; toleranceM: number };
export function evaluateElement(el: OsmElement, options?: Partial<BuildOptions>): { ok: true; candidate: OsmCandidate } | { ok: false; reason: string };
export function placeIdFor(osmType: string, osmId: number): string;
export function dedupeCandidates(candidates: OsmCandidate[], existing?: ExistingPlaces, dedupeMeters?: number): { kept: OsmCandidate[]; dropped: Record<string, number> };
export function buildPlaces(elements: OsmElement[], options?: BuildOptions): BuildResult;
export function sqlText(value: unknown): string;
export function renderPlaceSql(place: OsmPlace, ctx: ImportContext): string[];
export function renderImportSql(places: OsmPlace[], ctx: ImportContext): string;
export function renderRollbackSql(batch: string): string;
export function buildSummary(result: BuildResult, ctx: ImportContext, sqlBytes: number): Record<string, unknown>;
export function parseArgs(argv: string[]): Record<string, unknown>;
export function main(argv?: string[]): Promise<{ imported: number; byCategory: Record<string, { count: number; samples: string[] }> }>;
