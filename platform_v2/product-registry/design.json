{
  "schema_version": "1.0.0",
  "product_id": "zukan",
  "foundations": [
    {
      "id": "foundation.universal-web-v1",
      "rules": {
        "minimum_touch_target_px": 44,
        "normal_text_contrast_ratio": 4.5,
        "large_text_contrast_ratio": 3,
        "maximum_horizontal_overflow_px": 1,
        "focus_visible_required": true,
        "reduced_motion_supported": true,
        "responsive_viewports": [
          320,
          375,
          390,
          412,
          768,
          1024,
          1440
        ],
        "spacing_scale_px": [
          4,
          8,
          12,
          16,
          24,
          32,
          40,
          56
        ],
        "freehand_color_values_allowed": false,
        "surface_specific_css_requires_exception": true
      }
    }
  ],
  "brands": [
    {
      "id": "brand.zukan-v1",
      "foundation": "foundation.universal-web-v1",
      "voice": [
        "身近",
        "観察を急いで確定しない",
        "行動を具体的にする",
        "不安を煽らない"
      ],
      "navigation_labels": [
        "ホーム",
        "記録",
        "場所",
        "参加",
        "自分",
        "撮る"
      ],
      "tokens": {
        "text_primary": "#17211b",
        "text_secondary": "#55615a",
        "brand_primary": "#143f2e",
        "surface": "#ffffff",
        "surface_soft": "#f7f7f3",
        "focus_ring": "#143f2e"
      }
    }
  ],
  "archetypes": [
    {
      "id": "archetype.marketing-home",
      "required_regions": [
        "value-proposition",
        "primary-action",
        "proof-or-live-content",
        "secondary-paths"
      ],
      "rules": [
        "ログイン前は価値提示を優先する",
        "主CTAは撮影開始とする",
        "複数CTAを同じ強さにしない"
      ]
    },
    {
      "id": "archetype.capture-flow",
      "required_regions": [
        "current-step",
        "capture-or-select",
        "privacy-context",
        "primary-action",
        "recovery-action"
      ],
      "rules": [
        "片手操作を優先する",
        "送信中と成功を区別する",
        "通信失敗後に再試行できる"
      ]
    },
    {
      "id": "archetype.public-browser",
      "required_regions": [
        "search-or-filter",
        "result-context",
        "results",
        "empty-state",
        "capture-entry"
      ],
      "rules": [
        "公開範囲だけを表示する",
        "0件と障害を区別する",
        "検索条件を解除できる"
      ]
    },
    {
      "id": "archetype.map-explorer",
      "required_regions": [
        "map",
        "privacy-context",
        "fallback",
        "records-entry"
      ],
      "rules": [
        "位置精度を過剰に示さない",
        "地図が使えなくても記録一覧へ移動できる"
      ]
    },
    {
      "id": "archetype.personal-library",
      "required_regions": [
        "owner-context",
        "primary-action",
        "records",
        "empty-state",
        "error-recovery"
      ],
      "rules": [
        "本人限定か公開混在かを明示する",
        "空状態から新規記録へ進める",
        "他人のprivate dataを表示しない"
      ]
    },
    {
      "id": "archetype.program-flow",
      "required_regions": [
        "purpose",
        "privacy-context",
        "primary-action",
        "recovery-action"
      ],
      "rules": [
        "主催者・参加者の権限境界を明示する",
        "作成・参加・振り返りを成功表示だけで混同しない",
        "再開催は既存templateへ戻す"
      ]
    },
    {
      "id": "archetype.campaign-landing",
      "required_regions": [
        "single-message",
        "safety-context",
        "primary-action",
        "owner-return-path"
      ],
      "rules": [
        "一つの対象と一つの主行動に絞る",
        "通報・自動公開・AI確定と誤認させない"
      ]
    }
  ],
