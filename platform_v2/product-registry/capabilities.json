      "title": "公開範囲の場所と記録を見る",
      "actor": "visitor_or_member",
      "operation": "read",
      "privacy": "public-filtered-location",
      "side_effects": []
    },
    {
      "id": "zukan.home.view-member",
      "title": "自分のHomeを見る",
      "actor": "member",
      "operation": "read",
      "privacy": "mixed-owner-and-public",
      "side_effects": []
