      "title": "撮影を開始する",
      "actor": "visitor_or_member",
      "operation": "read",
      "privacy": "private-draft",
      "side_effects": []
    },
    {
      "id": "zukan.record.save-private",
      "title": "記録を非公開保存する",
      "actor": "member",
      "operation": "write",
