  "negative_property_tests":[
    {"id":"prop.capture.same-intent-one-record","requirements":["quality.zukan.capture.idempotent-save"],"property":"同一capture intentをN回replayしても1 logical observation + 1 logical media setへ収束","current_test":"platform_v2/e2e/record-capture-retry.zukan.staging.spec.ts"},
    {"id":"prop.capture.same-key-different-payload-conflict","requirements":["quality.zukan.capture.idempotent-save"],"property":"同一idempotency keyの異なるpayloadは既存recordを上書きしない","current_test":"planned"},
    {"id":"prop.capture.partial-failure-recoverable","requirements":["quality.zukan.capture.draft-recovery","quality.zukan.capture.idempotent-save"],"property":"media/AI/network partial failure後もrecord/draftを失わずretryで重複しない","current_test":"platform_v2/e2e/record-capture-retry.zukan.staging.spec.ts"},
    {"id":"prop.capture.permission-denial-nondestructive","requirements":["quality.zukan.capture.location-optional","quality.zukan.capture.source-choice"],"property":"camera/location拒否は記録中データを破棄せず代替経路を提示","current_test":"planned"},
    {"id":"prop.public.no-private-leak","requirements":["quality.zukan.trust.private-default","quality.zukan.trust.public-projection"],"property":"private/rejected/quarantined/blocked mediaはpublic API/HTML/map/feed/cacheの全投影で0件","current_test":"planned"},
    {"id":"prop.public.no-exact-location","requirements":["quality.zukan.trust.location-minimization","quality.zukan.trust.public-projection"],"property":"public URL/HTML/API/feedにexact coordinatesを含めず許可された粗化位置だけを出す","current_test":"planned"},
    {"id":"prop.public.scope-monotonic-by-explicit-action","requirements":["quality.zukan.trust.explicit-publication","quality.zukan.trust.existing-rights-preserved"],"property":"権限ある明示操作なしにvisibility scopeが広がらない","current_test":"planned"},
    {"id":"prop.privacy.face-private-place-fail-closed","requirements":["quality.zukan.trust.face-private-place-safety"],"property":"face/生活場所/私有地riskはsilent public expansionを起こさない","current_test":"planned"},
    {"id":"prop.ai.failure-never-becomes-fact","requirements":["quality.zukan.capture.ai-candidate","quality.zukan.trust.ai-candidate-not-fact"],"property":"timeout/malformed/low confidenceでも保存継続しAI値をverifiedへ昇格しない","current_test":"planned"},
    {"id":"prop.provenance.human-not-overwritten-by-ai","requirements":["quality.zukan.trust.confirmation-provenance"],"property":"後続AI処理が人/専門家確認provenanceを上書きしない","current_test":"planned"},
    {"id":"prop.live-camera.unlicensed-source-not-exposed","requirements":["quality.zukan.map.live-camera-source-eligibility"],"property":"reuse/embed/attribution根拠がunknownまたは不許可のcameraは地図layerへ公開しない","current_test":"planned"},
    {"id":"prop.live-camera.source-import-idempotent","requirements":["quality.zukan.map.live-camera-source-eligibility","quality.zukan.map.live-camera-health"],"property":"同一provider + source_refをN回取込しても1 logical cameraへ収束し、権利・死活履歴を破壊しない","current_test":"planned"},
    {"id":"prop.live-camera.dead-never-live","requirements":["quality.zukan.map.live-camera-health"],"property":"deleted/private/ended/unverified sourceをLIVE表示せず、最終確認時刻を偽らない","current_test":"planned"},
    {"id":"prop.live-camera.player-only-on-selection","requirements":["quality.zukan.map.live-camera-lazy-playback"],"property":"layer OFFまたはcamera未選択/close後はYouTube等のplayer/iframe resourceがactiveでない","current_test":"planned"},
    {"id":"prop.live-camera.outage-isolated","requirements":["quality.zukan.map.live-camera-health","quality.zukan.map.live-camera-lazy-playback"],"property":"provider timeout/403/404/endedでもMap/Recordsの閲覧・操作を継続できる","current_test":"planned"},
    {"id":"prop.live-camera.no-frame-processing-without-rights","requirements":["quality.zukan.map.live-camera-source-eligibility"],"property":"別途の権利契約がないcameraからframe snapshot/storage/extraction/AI inferenceを行わない","current_test":"planned"},
    {"id":"prop.workspace.authz-fail-closed","requirements":["quality.zukan.workspace.membership-authorization","quality.zukan.workspace.review"],"property":"非member/権限外actorはread/write/review不可","current_test":"planned"},
    {"id":"prop.workspace.retry-converges","requirements":["quality.zukan.workspace.contribution"],"property":"同一contribution/review replayは重複せず同じlogical stateへ収束","current_test":"planned"}
