# Copy this file to /etc/ikimon/production-verification.env on the management server.
# Keep the installed file root-readable only and never commit a real token.
GITHUB_REPOSITORY=yamaki0102/ikimon-platform
GITHUB_API_URL=https://api.github.com
# GITHUB_TOKEN must be added to the installed copy with repository commit-status write permission.
# GITHUB_TOKEN=
