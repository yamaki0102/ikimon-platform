# Root-managed environment for ikimon-production-verification.service.
# Install as /etc/ikimon/production-verification.env with mode 0640.

GITHUB_REPOSITORY=yamaki0102/ikimon-platform
PUBLISH_GITHUB_STATUS=false

# Add one status-only token before enabling GitHub status publishing.
# Never commit a real token to this repository.
# GITHUB_TOKEN=

# Optional: link the commit status to an internal evidence page.
# IKIMON_VERIFICATION_TARGET_URL=

# The service unit supplies these defaults. Override only when needed.
# SMOKE_TIER=targeted
# PLAYWRIGHT_INSTALL_WITH_DEPS=false
# IKIMON_VERIFICATION_ARCHIVE_RETENTION_DAYS=14
