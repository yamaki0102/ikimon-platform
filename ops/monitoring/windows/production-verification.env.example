# Stored at C:\ProgramData\IKIMON\production-verification.env.
# The installer restricts the ACL to SYSTEM and local Administrators.

GITHUB_REPOSITORY=yamaki0102/ikimon-platform
PUBLISH_GITHUB_STATUS=false

# Add a commit-status-only token before enabling status publishing.
# Never commit a real token to this repository.
# GITHUB_TOKEN=

# Optional internal evidence or runbook URL for the commit status.
# IKIMON_STATUS_TARGET_URL=

# Optional overrides.
# SMOKE_TIER=targeted
# PLAYWRIGHT_INSTALL_WITH_DEPS=false
# IKIMON_VERIFICATION_ARCHIVE_RETENTION_DAYS=14
