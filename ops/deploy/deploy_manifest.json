{
  "version": 8,
  "strategy": "cloudflare_executor_primary",
  "platform": "cloudflare_worker",
  "githubActionsDependency": {
    "required": false,
    "classification": "reference_only",
    "executionBackend": false
  },
  "workerName": "ikimon-life-cloudflare-prod",
  "workerDirectory": "platform_v2/cloudflare_shadow",
  "executionLanes": {
    "primary": {
      "id": "cloudflare_executor",
      "commandBus": "yamaki0102/all-projects-management issues labeled ops:command",
      "executor": "ikimon-intake-cloud-executor",
      "actions": ["status", "dry_run", "setup", "migrate", "deploy", "verify", "visual_qa", "rollback"],
      "immutableShaRequired": true
    },
    "emergency": {
      "id": "manual_emergency",
      "entrypoint": "scripts/run_cloudflare_production_worker_deploy.sh",
      "explicitApprovalRequired": true
    }
  },
  "r2Bucket": "ikimon-prod-media",
  "materializedOriginalUiScope": "core",
  "productionPhaseInterface": {
    "schema": "ikimon_production_phase_interface/v1",
    "resultSchema": "ikimon.production-phase-result/v1",
    "freshSandboxRequired": true,
    "productionD1Migrations": false,
    "combinedExecuteEntrypointAllowed": false,
    "secretInjectionAfterPreparationRequired": true,
    "processTableEmptyBeforeSecretInjectionRequired": true,
    "secretFreeAncestorRequired": true,
    "initialEnvironmentSecretAllowlistEnforced": true,
    "preflightReceiptVerifiedByExecutorBeforeSecretInjection": true,
    "localToolchain": {
      "customWranglerBuildCommandAllowed": false,
      "tools": {
        "tsx": {
          "version": "4.22.4",
          "resolved": "https://registry.npmjs.org/tsx/-/tsx-4.22.4.tgz",
          "integrity": "sha512-X8EX+XV4QR5xCsrgxaED954zTDfY8KqlDtskKEL0cHhyS/P8b4IFOvGDQpsC9Q1XnLq915wEfwwY/zzskCtmhg=="
        },
        "wrangler": {
          "version": "4.110.0",
          "resolved": "https://registry.npmjs.org/wrangler/-/wrangler-4.110.0.tgz",
          "integrity": "sha512-xZeXKYi7hxQRF5anL+v77RkufJNpF9f3Eqeyqq2QBsETpLZgh0Agj0jJ6JPtkbgn6ukZdh8OK5egsGPWIditgg=="
        }
      }
    },
    "phases": {
      "preflight": {
        "marker": "ikimon.production-phase/v1:preflight",
        "entrypoint": "scripts/run_cloudflare_production_preflight.sh",
        "secretAllowlist": [],
        "nonSecretInputAllowlist": [
          "PATH",
          "HOME",
          "CI",
          "IKIMON_AUTOMATION_JOB_FILE",
          "IKIMON_TERMINAL_EVENT_FILE",
          "IKIMON_PRODUCTION_PHASE_V1",
          "IKIMON_PRODUCTION_SOURCE_DIR",
          "IKIMON_EXPECTED_GIT_SHA",
          "IKIMON_OPS_JOB_ID"
        ]
      },
      "materialize": {
        "marker": "ikimon.production-phase/v1:materialize",
        "entrypoint": "scripts/run_cloudflare_production_materialization.sh",
        "secretAllowlist": ["IKIMON_PRODUCTION_MATERIALIZATION_JOB_SECRET"],
        "nonSecretInputAllowlist": [
          "PATH",
          "HOME",
          "CI",
          "IKIMON_AUTOMATION_JOB_FILE",
          "IKIMON_TERMINAL_EVENT_FILE",
          "IKIMON_PRODUCTION_PHASE_V1",
          "IKIMON_PRODUCTION_SOURCE_DIR",
          "IKIMON_EXPECTED_GIT_SHA",
          "IKIMON_OPS_JOB_ID",
          "IKIMON_R2_MATERIALIZATION_API_URL"
        ]
      },
      "deploy": {
        "marker": "ikimon.production-phase/v1:deploy",
        "entrypoint": "scripts/run_cloudflare_production_worker_deploy.sh",
        "secretAllowlist": ["CLOUDFLARE_API_TOKEN"],
        "nonSecretInputAllowlist": [
          "PATH",
          "HOME",
          "CI",
          "IKIMON_AUTOMATION_JOB_FILE",
          "IKIMON_TERMINAL_EVENT_FILE",
          "IKIMON_PRODUCTION_PHASE_V1",
          "IKIMON_PRODUCTION_SOURCE_DIR",
          "IKIMON_EXPECTED_GIT_SHA",
          "IKIMON_OPS_JOB_ID",
          "CLOUDFLARE_ACCOUNT_ID",
          "DEPLOY_PRODUCTION",
          "IKIMON_GIT_SHA",
          "IKIMON_UI_BUNDLE_HASH",
          "IKIMON_UI_MANIFEST_HASH",
          "IKIMON_WORKER_VERSION",
          "IKIMON_DEPLOYED_AT",
          "IKIMON_CF_PRODUCTION_DEPLOY_APPROVAL",
          "IKIMON_PRODUCTION_PREFLIGHT_RECEIPT_SHA256",
          "IKIMON_PRODUCTION_D1_MIGRATIONS",
          "IKIMON_PRODUCTION_SECRET_SYNC"
        ]
      },
      "verify": {
        "marker": "ikimon.production-phase/v1:verify",
        "entrypoint": "executor:fixed-http-exact-sha",
        "secretAllowlist": [],
        "nonSecretInputAllowlist": [
          "PATH",
          "HOME",
          "CI",
          "IKIMON_AUTOMATION_JOB_FILE",
          "IKIMON_TERMINAL_EVENT_FILE",
          "IKIMON_PRODUCTION_PHASE_V1",
          "IKIMON_PRODUCTION_SOURCE_DIR",
          "IKIMON_EXPECTED_GIT_SHA",
          "IKIMON_OPS_JOB_ID",
          "IKIMON_UI_BUNDLE_HASH",
          "IKIMON_UI_MANIFEST_HASH"
        ]
      }
    }
  },
  "portableReleaseScript": "scripts/run_cloudflare_production_release.sh",
  "productionPreflightScript": "scripts/run_cloudflare_production_preflight.sh",
  "productionMaterializationScript": "scripts/run_cloudflare_production_materialization.sh",
  "productionWorkerDeployScript": "scripts/run_cloudflare_production_worker_deploy.sh",
  "portableVerifyScript": "scripts/verify_cloudflare_production_release.sh",
  "verificationWatchScript": "scripts/run_production_verification_watch.sh",
  "verificationReportBuilder": "scripts/build_production_verification_report.mjs",
  "verificationArchiveScript": "scripts/archive_production_verification_evidence.mjs",
  "verificationStatusPublisher": "scripts/publish_production_verification_status.mjs",
  "verificationInstaller": "scripts/install_production_verification_service.sh",
  "verificationDoctor": "scripts/doctor_production_verification_service.sh",
  "verificationWindowsRunner": "scripts/Invoke-ProductionVerificationWatch.ps1",
  "verificationWindowsInstaller": "scripts/Install-ProductionVerificationScheduledTask.ps1",
  "verificationWindowsDoctor": "scripts/Test-ProductionVerificationWindows.ps1",
  "verificationPolicyPath": "ops/monitoring/production_verification_policy.json",
  "verificationAdapterContract": "ops/monitoring/production_verification_adapter.json",
  "verificationSystemdService": "ops/monitoring/systemd/ikimon-production-verification.service",
  "verificationSystemdTimer": "ops/monitoring/systemd/ikimon-production-verification.timer",
  "verificationEnvironmentExample": "ops/monitoring/systemd/production-verification.env.example",
  "verificationWindowsEnvironmentExample": "ops/monitoring/windows/production-verification.env.example",
  "verificationStatusContext": "ikimon/production-verification",
  "productionScopePlanner": "scripts/plan_production_release_scope.mjs",
  "triggerPolicy": {
    "commandBusOnly": true,
    "pathFiltered": true,
    "controlOnlySkipsMutation": true,
    "exactShaRequired": true,
    "statusAggregationBestEffort": true
  },
  "verificationOperations": {
    "recommendedCadenceMinutes": 15,
    "historicalRetentionDays": 14,
    "serviceStateDirectory": "/var/lib/ikimon-production-verification",
    "environmentFile": "/etc/ikimon/production-verification.env",
    "installerPreservesExistingEnvironment": true,
    "installerAcceptsSecretsOnCommandLine": false,
    "timerEnableRequiresHostAccess": true,
    "windowsStateDirectory": "%ProgramData%\\IKIMON\\production-verification",
    "windowsEnvironmentFile": "%ProgramData%\\IKIMON\\production-verification.env",
    "windowsTaskName": "IKIMON Production Verification",
    "windowsTaskPrincipal": "SYSTEM",
    "windowsInstallerPreservesExistingEnvironment": true,
    "windowsInstallerAcceptsSecretsOnCommandLine": false,
    "windowsTaskEnableRequiresHostAccess": true,
    "windowsInitialSystemRunRequired": true
  },
  "healthChecks": [
    "https://ikimon-life-cloudflare-prod.yamaki0102.workers.dev/healthz",
    "https://ikimon-life-cloudflare-prod.yamaki0102.workers.dev/readyz",
    "https://zukan.earth/healthz",
    "https://zukan.earth/readyz",
    "https://zukan.earth/",
    "https://zukan.earth/ja/map",
    "https://zukan.earth/ja/learn",
    "https://zukan.earth/ja/contact",
    "https://ikimon.life/healthz",
    "https://ikimon.life/readyz",
    "https://ikimon.life/",
    "https://ikimon.life/ja/map",
    "https://ikimon.life/ja/learn",
    "https://ikimon.life/ja/contact"
  ],
  "requiredChecks": [
    "PR Quality Gate and Ai Review Gate before merge",
    "node --test scripts/tests/production_release_scope.tests.mjs scripts/tests/production_verification_evidence.tests.mjs scripts/tests/production_verification_operations.tests.mjs scripts/tests/production_verification_centralization.tests.mjs",
    "powershell -ExecutionPolicy Bypass -File .\\scripts\\tests\\release_automation.tests.ps1",
    "powershell -ExecutionPolicy Bypass -File .\\scripts\\check_deploy_guardrails.ps1",
    "powershell -ExecutionPolicy Bypass -File .\\scripts\\check_deploy_manifest_sync.ps1",
    "bash scripts/tests/production_phase_interface.tests.sh",
    "bash scripts/run_cloudflare_production_preflight.sh without production secrets",
    "bash scripts/run_cloudflare_production_worker_deploy.sh only in a fresh approval-bound deploy sandbox",
    "bash scripts/run_production_verification_watch.sh",
    "node scripts/archive_production_verification_evidence.mjs",
    "node scripts/publish_production_verification_status.mjs",
    "sudo bash scripts/install_production_verification_service.sh --create-user",
    "powershell -ExecutionPolicy Bypass -File .\\scripts\\Install-ProductionVerificationScheduledTask.ps1 -DryRun"
  ],
  "forbiddenPaths": [
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.sqlite3-shm",
    "**/*.sqlite3-wal",
    "**/*.db",
    "**/credentials.json",
    "**/.env",
    "**/debug_*.php",
    "**/test_*.php",
    "tmp_*",
    "**/*.bak"
  ],
  "notes": [
    "Production mutation is triggered only by an eligible main push whose changed files affect the current app, Worker runtime, bindings, migrations, dependencies, or materialized UI.",
    "Documentation, test-only, monitoring, Linux service controls, Windows scheduled-task controls, and other production control-plane-only changes do not mutate the production Worker, D1, or R2.",
    "Cloudflare Queue and Sandbox Executor are the only normal build, deploy, verify, visual QA, and rollback execution layer. GitHub is limited to source, pull requests, immutable SHA resolution, command intake, and audit evidence.",
    "Production verification writes a no-personal-data JSON report bound to the exact public runtime SHA; its adapter remains in this repository while recurring execution, canonical evidence, and alerting are owned by yamaki0102/all-projects-management.",
    "The Linux timer uses a private systemd StateDirectory; the Windows task uses private ProgramData ACLs and runs as SYSTEM. Both archive SHA-bound evidence for 14 days.",
    "Linux and Windows installers preserve existing secret environment files, refuse token command-line options, and require a successful direct verification before recurring scheduling is enabled.",
    "The Windows installer also executes and validates the registered SYSTEM task so user-only drive or permission mistakes are detected during installation.",
    "The repository-local Linux and Windows host integrations are deprecated for new installations; removal requires at least 48 hours of successful central shadow evidence and an explicit operator decision.",
    "Production release uses isolated fresh sandboxes for preflight, R2 materialization, Worker deploy, and verification. The compatibility release command is secretless preflight-only and rejects execute mode.",
    "Production Worker deploy receives only the Cloudflare token after the Executor verifies the exact checkout, preflight receipt digest, materialized UI hashes, prepared dependencies, and an empty process table. The target entrypoint then replaces its shell with direct local Wrangler.",
    "Routine production deploy never applies D1 migrations; productionD1Migrations is false in the machine-readable phase contract.",
    "The production public entrypoint is Cloudflare Worker ikimon-life-cloudflare-prod, not the legacy VPS blue/green lane.",
    "The production Worker must not own staging.zukan.earth or staging.ikimon.life routes; Cloudflare staging owns the staging.zukan.earth custom domain and retains staging.ikimon.life/* through ikimon-life-cloudflare-staging.",
    "Routine production deploy must not use VPS SSH, deploy_platform_v2_blue_green.sh, or VPS_SSH_KEY.",
    "Routine production deploy must not change DNS, custom domains, secrets, billing, provider settings, or VPS state.",
    "R2 writes in routine deploy are limited to generated original UI HTML/static assets and materialization metadata from the exact deployed commit."
  ]
}
